<Window x:Class="Friday.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Friday"
        Title="Friday"
        Height="900" Width="1600"
        MinHeight="640" MinWidth="1200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseDown="Window_MouseDown"
        UseLayoutRounding="True">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <!-- 1. АНИМАЦИЯ ПОЯВЛЕНИЯ ИНТЕРФЕЙСА (ОДИН РАЗ) -->
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootGrid"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.4"/>
                    <DoubleAnimation Storyboard.TargetName="RootGrid"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="16" To="0" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>

            <!-- 2. АНИМАЦИЯ КОЛЕЦ МИКРОФОНА (БЕСКОНЕЧНО) -->
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="OrbRing1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.4" To="1.45" Duration="0:0:2.8"/>
                    <DoubleAnimation Storyboard.TargetName="OrbRing1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.4" To="1.45" Duration="0:0:2.8"/>
                    <DoubleAnimation Storyboard.TargetName="OrbRing1" Storyboard.TargetProperty="Opacity" From="0.55" To="0" Duration="0:0:2.8"/>

                    <DoubleAnimation Storyboard.TargetName="OrbRing2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.4" To="1.45" Duration="0:0:2.8" BeginTime="0:0:0.9"/>
                    <DoubleAnimation Storyboard.TargetName="OrbRing2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.4" To="1.45" Duration="0:0:2.8" BeginTime="0:0:0.9"/>
                    <DoubleAnimation Storyboard.TargetName="OrbRing2" Storyboard.TargetProperty="Opacity" From="0.4" To="0" Duration="0:0:2.8" BeginTime="0:0:0.9"/>

                    <DoubleAnimation Storyboard.TargetName="OrbRing3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.4" To="1.45" Duration="0:0:2.8" BeginTime="0:0:1.8"/>
                    <DoubleAnimation Storyboard.TargetName="OrbRing3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.4" To="1.45" Duration="0:0:2.8" BeginTime="0:0:1.8"/>
                    <DoubleAnimation Storyboard.TargetName="OrbRing3" Storyboard.TargetProperty="Opacity" From="0.25" To="0" Duration="0:0:2.8" BeginTime="0:0:1.8"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <local:MessageAlignmentConverter x:Key="AlignmentConverter"/>
        <local:MessageBackgroundConverter x:Key="BgConverter"/>
        <local:MessageTextConverter x:Key="TextConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <FontFamily x:Key="BrandFont">Segoe UI, Montserrat, Inter</FontFamily>
        <FontFamily x:Key="UI">Segoe UI, Inter</FontFamily>
        <FontFamily x:Key="Icons">Segoe MDL2 Assets</FontFamily>

        <!-- FRIDAY SERVER LIGHT DESIGN SYSTEM -->
        <SolidColorBrush x:Key="Bg"           Color="#F2F8FD"/>
        <SolidColorBrush x:Key="BgSidebar"    Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgPanel"      Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgInput"      Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderDim"    Color="#DCE6F0"/>
        <SolidColorBrush x:Key="BorderStrong" Color="#C9D7E5"/>
        <SolidColorBrush x:Key="BorderFocus"  Color="#3A98D8"/>
        <SolidColorBrush x:Key="Accent"       Color="#3A98D8"/>
        <SolidColorBrush x:Key="AccentBright" Color="#2478B4"/>
        <SolidColorBrush x:Key="AccentGlow"   Color="#755BC8"/>
        <SolidColorBrush x:Key="TextHigh"     Color="#1E2330"/>
        <SolidColorBrush x:Key="TextMid"      Color="#667085"/>
        <SolidColorBrush x:Key="TextLow"      Color="#98A2B3"/>
        <SolidColorBrush x:Key="Danger"       Color="#B83C54"/>

        <!-- GRADIENTS -->
        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3A98D8" Offset="0"/>
            <GradientStop Color="#755BC8" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BgUserBubble" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2478B4" Offset="0"/>
            <GradientStop Color="#6850B7" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="OrbFill" StartPoint="0.1,0.1" EndPoint="0.9,0.9">
            <GradientStop Color="#3A98D8" Offset="0"/>
            <GradientStop Color="#5A7CD0" Offset="0.5"/>
            <GradientStop Color="#755BC8" Offset="1"/>
        </LinearGradientBrush>

        <!-- SCROLLBAR -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="#C9D7E5" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PRIMARY BUTTON -->
        <Style TargetType="Button">
            <Setter Property="Foreground"       Value="#FFFFFF"/>
            <Setter Property="BorderBrush"      Value="{x:Null}"/>
            <Setter Property="FontFamily"       Value="{StaticResource UI}"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Height"           Value="40"/>
            <Setter Property="Padding"          Value="18,0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="10" Background="{StaticResource BgUserBubble}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.80"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SECONDARY BUTTON (White card with border) -->
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Foreground"       Value="{StaticResource TextHigh}"/>
            <Setter Property="FontFamily"       Value="{StaticResource UI}"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Height"           Value="38"/>
            <Setter Property="Padding"          Value="16,0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource BorderDim}" Background="{StaticResource BgPanel}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F2F8FD"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBright}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E2EFFB"/>
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TOGGLE BUTTON -->
        <Style x:Key="ToggleOutline" TargetType="{x:Type ToggleButton}">
            <Setter Property="Foreground"       Value="{StaticResource TextMid}"/>
            <Setter Property="FontFamily"       Value="{StaticResource UI}"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Height"           Value="36"/>
            <Setter Property="Padding"          Value="14,0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="b" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource BorderDim}" Background="{StaticResource BgPanel}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F2F8FD"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBright}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#EBF5FD"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBright}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- WINDOW CHROME BUTTONS -->
        <Style x:Key="ChromeBtn" TargetType="Button">
            <Setter Property="Width"            Value="42"/>
            <Setter Property="Height"           Value="32"/>
            <Setter Property="Foreground"       Value="{StaticResource TextMid}"/>
            <Setter Property="FontFamily"       Value="{StaticResource Icons}"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6" Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="{StaticResource TextHigh}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Width"            Value="42"/>
            <Setter Property="Height"           Value="32"/>
            <Setter Property="Foreground"       Value="{StaticResource TextMid}"/>
            <Setter Property="FontFamily"       Value="{StaticResource Icons}"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6" Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TEXTBOX -->
        <Style TargetType="TextBox">
            <Setter Property="Background"               Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"               Value="{StaticResource TextHigh}"/>
            <Setter Property="CaretBrush"               Value="{StaticResource AccentBright}"/>
            <Setter Property="SelectionBrush"           Value="#D0E7F9"/>
            <Setter Property="FontFamily"               Value="{StaticResource UI}"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Padding"                  Value="14,0"/>
            <Setter Property="Height"                   Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource BorderDim}"
                                Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                          Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMBOBOX -->
        <Style x:Key="CbToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="r" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource BorderDim}" Background="{StaticResource BgPanel}">
                            <Grid>
                                <ContentPresenter VerticalAlignment="Center" Margin="14,0,28,0"/>
                                <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource TextMid}"
                                      HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="r" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="r" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground"       Value="{StaticResource TextHigh}"/>
            <Setter Property="FontFamily"       Value="{StaticResource UI}"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="Height"           Value="40"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton Style="{StaticResource CbToggle}"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              VerticalAlignment="Center" Margin="14,0,32,0"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" PopupAnimation="Slide">
                                <Border Background="{StaticResource BgPanel}"
                                        BorderBrush="{StaticResource BorderDim}"
                                        BorderThickness="1" CornerRadius="10" Margin="0,4,0,0" Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#1E2330" BlurRadius="18" ShadowDepth="4" Opacity="0.1"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="200" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource TextHigh}"/>
            <Setter Property="FontFamily" Value="{StaticResource UI}"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Height"     Value="36"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="bd" CornerRadius="8" Padding="12,0" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F2F8FD"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBright}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EBF5FD"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBright}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FLOATING ACTION ICON BUTTON (ДЛЯ ВСПЛЫВАШЕК СООБЩЕНИЙ) -->
        <Style x:Key="FloatingActionIconBtn" TargetType="Button">
            <Setter Property="Width"            Value="28"/>
            <Setter Property="Height"           Value="26"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground"       Value="{StaticResource TextMid}"/>
            <Setter Property="FontFamily"       Value="{StaticResource Icons}"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F2F8FD"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBright}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E2EFFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BUBBLE ACTION BUTTON -->
        <Style x:Key="BubbleActionBtn" TargetType="Button">
            <Setter Property="Foreground"       Value="{StaticResource TextMid}"/>
            <Setter Property="FontFamily"       Value="{StaticResource UI}"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Height"           Value="26"/>
            <Setter Property="Padding"          Value="10,0"/>
            <Setter Property="Margin"           Value="0,0,6,0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="#F2F8FD" BorderBrush="{StaticResource BorderDim}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E2EFFB"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBright}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- WINDOW FRAME WITH SHADOW & CORNER RADIUS -->
    <Border CornerRadius="16" Background="{StaticResource Bg}" BorderBrush="{StaticResource BorderDim}" BorderThickness="1" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#1E2330" BlurRadius="40" ShadowDepth="10" Opacity="0.14"/>
        </Border.Effect>
        <Grid x:Name="RootGrid">
            <Grid.RenderTransform>
                <TranslateTransform/>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. TOP TITLEBAR -->
            <Grid Grid.Row="0" Margin="16,0,10,0">
                <!-- LEFT: BRAND LOGO & STATUS -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="28" Height="28" Margin="0,0,10,0">
                        <Canvas Width="132" Height="132">
                            <Canvas.Resources>
                                <LinearGradientBrush x:Key="LogoGrad" StartPoint="0.14,0.14" EndPoint="0.86,0.89">
                                    <GradientStop Color="#3A98D8" Offset="0"/>
                                    <GradientStop Color="#755BC8" Offset="1"/>
                                </LinearGradientBrush>
                            </Canvas.Resources>
                            <Path Data="M42.4285 30.1714H89.5714C104.657 30.1714 113.143 38.6571 113.143 53.7429V88.6286C113.143 103.714 104.657 112.2 89.5714 112.2H67.8857L49.0285 126.343V112.2H42.4285C27.3428 112.2 18.8571 103.714 18.8571 88.6286V53.7429C18.8571 38.6571 27.3428 30.1714 42.4285 30.1714Z"
                                  Stroke="{StaticResource LogoGrad}" StrokeThickness="8" StrokeLineJoin="Round"/>
                            <Path Data="M66 30.1714V16.9714" Stroke="{StaticResource LogoGrad}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M66 18.8571C70.1658 18.8571 73.5429 15.4801 73.5429 11.3143C73.5429 7.14848 70.1658 3.77142 66 3.77142C61.8342 3.77142 58.4572 7.14848 58.4572 11.3143C58.4572 15.4801 61.8342 18.8571 66 18.8571Z"
                                  Fill="{StaticResource LogoGrad}"/>
                            <Path Data="M48.0857 80.1428C53.2929 80.1428 57.5142 75.9215 57.5142 70.7143C57.5142 65.507 53.2929 61.2857 48.0857 61.2857C42.8784 61.2857 38.6571 65.507 38.6571 70.7143C38.6571 75.9215 42.8784 80.1428 48.0857 80.1428Z"
                                  Fill="{StaticResource LogoGrad}"/>
                            <Path Data="M84.8572 80.1428C90.0644 80.1428 94.2857 75.9215 94.2857 70.7143C94.2857 65.507 90.0644 61.2857 84.8572 61.2857C79.6499 61.2857 75.4286 65.507 75.4286 70.7143C75.4286 75.9215 79.6499 80.1428 84.8572 80.1428Z"
                                  Fill="{StaticResource LogoGrad}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Пятница" FontFamily="{StaticResource BrandFont}"
                               FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextHigh}" VerticalAlignment="Center"/>
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="10,0,6,0"
                             Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="WINDOWS КЛИЕНТ" FontFamily="{StaticResource UI}"
                               FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextLow}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- RIGHT: CONTROLS & CHROME -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton" Content="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="14" ToolTip="Настройки" Width="36" Height="30" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,6,0" Click="SettingsButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource BorderDim}" Background="{StaticResource BgPanel}">
                                    <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{StaticResource TextHigh}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#F2F8FD"/>
                                        <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#E2EFFB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="UserButton" Height="30" Style="{StaticResource DarkButtonStyle}"
                            Click="UserButton_Click" Padding="12,0" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="{StaticResource Icons}"
                                       FontSize="12" Foreground="{StaticResource AccentBright}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="UserButtonText" Text="Пользователь"
                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                       FontFamily="{StaticResource UI}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextHigh}"/>
                        </StackPanel>
                    </Button>
                    <Button Content="&#xE921;" Click="Minimize_Click" Style="{StaticResource ChromeBtn}"/>
                    <Button Content="&#xE922;" Click="Maximize_Click" Style="{StaticResource ChromeBtn}"/>
                    <Button Content="&#xE8BB;" Click="Close_Click"    Style="{StaticResource CloseBtn}"/>
                </StackPanel>
            </Grid>

            <!-- 2. MAIN WORKSPACE (DIALOGS ON LEFT, CHAT ON RIGHT) -->
            <Grid Grid.Row="1" Margin="16,0,16,16">
                <Grid.ColumnDefinitions>
                    <!-- 0: Панель диалогов (слева) | 1: Сплиттер | 2: Область чата (справа) -->
                    <ColumnDefinition x:Name="DialogsColumn" Width="280" MinWidth="220" MaxWidth="500"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="ChatColumn" Width="*" MinWidth="500"/>
                </Grid.ColumnDefinitions>

                <!-- БОКОВАЯ ПАНЕЛЬ ДИАЛОГОВ (СЛЕВА) -->
                <Border x:Name="DialogsPanel" Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDim}" BorderThickness="1" CornerRadius="16" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="#1E2330" BlurRadius="18" ShadowDepth="4" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="NewChatButton" Grid.Row="0" Content="+  НОВЫЙ ЧАТ" Height="38" Style="{StaticResource DarkButtonStyle}" Margin="12,14,12,10" FontSize="12" FontWeight="Bold" Click="NewChatButton_Click"/>

                        <Grid Grid.Row="1" Margin="16,4,16,10">
                            <TextBlock Text="ДИАЛОГИ" FontFamily="{StaticResource UI}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMid}"/>
                            <TextBlock x:Name="DialogsCountText" HorizontalAlignment="Right" FontFamily="{StaticResource UI}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextLow}"/>
                        </Grid>

                        <Rectangle Grid.Row="2" Fill="{StaticResource BorderDim}"/>

                        <ListBox x:Name="DialogListBox" Grid.Row="3" Background="Transparent" BorderThickness="0" Margin="8,8,8,10" VerticalAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" VirtualizingPanel.ScrollUnit="Pixel" SelectionChanged="DialogListBox_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,3,0,3"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="DlgBorder" CornerRadius="10" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="12,9">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="DlgBorder" Property="Background" Value="#F2F8FD"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="DlgBorder" Property="Background" Value="#EBF5FD"/>
                                                        <Setter TargetName="DlgBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" ToolTip="{Binding Name}" FontFamily="{StaticResource UI}" FontSize="13" Foreground="{StaticResource TextHigh}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="✕" Style="{StaticResource BubbleActionBtn}" ToolTip="Удалить диалог" Margin="6,0,0,0" Click="DeleteDialogButton_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- РАЗДЕЛИТЕЛЬ КОЛОНОК -->
                <GridSplitter x:Name="DialogsSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" ShowsPreview="False" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Visibility="Collapsed" Cursor="SizeWE" Background="Transparent" DragCompleted="DialogsSplitter_DragCompleted"/>

                <!-- ОБЛАСТЬ ЧАТА (СПРАВА) -->
                <Grid Grid.Column="2" Margin="10,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ВЕРХНЯЯ ШАПКА ЧАТА -->
                    <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDim}" BorderThickness="1" CornerRadius="16" Padding="18,14" Margin="0,0,0,14">
                        <Border.Effect>
                            <DropShadowEffect Color="#1E2330" BlurRadius="18" ShadowDepth="4" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- GLOWING MICROPHONE ORB -->
                            <Grid Grid.Column="0" Width="68" Height="68" Margin="0,0,18,0">
                                <Ellipse x:Name="OrbRing1" Width="68" Height="68" Stroke="{StaticResource Accent}" StrokeThickness="1.5" Fill="Transparent" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="OrbRing2" Width="68" Height="68" Stroke="{StaticResource AccentGlow}" StrokeThickness="1.5" Fill="Transparent" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="OrbRing3" Width="68" Height="68" Stroke="{StaticResource AccentBright}" StrokeThickness="1.5" Fill="Transparent" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse Width="54" Height="54" Stroke="{StaticResource BorderDim}" StrokeThickness="1" Fill="Transparent"/>

                                <Button x:Name="ListenButton" Width="44" Height="44" Click="ListenButton_Click" ToolTip="Голосовой ввод" Background="Transparent" BorderBrush="{x:Null}" FocusVisualStyle="{x:Null}" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Ellipse x:Name="OrbCore" Fill="{StaticResource OrbFill}">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#3A98D8" BlurRadius="22" ShadowDepth="0" Opacity="0.75"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <TextBlock Text="🎤" FontFamily="Segoe UI Emoji" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- HEADER TITLES -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Голосовой ассистент" FontFamily="{StaticResource BrandFont}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextHigh}"/>
                                <TextBlock Text="Нажми на орб или напечатай сообщение" FontFamily="{StaticResource UI}" FontSize="12" Foreground="{StaticResource TextMid}" Margin="1,4,0,0"/>
                            </StackPanel>

                            <!-- HEADER ACTION BUTTONS -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton x:Name="CameraBtn" Content="📷 Камера" Style="{StaticResource ToggleOutline}" Width="100" Margin="0,0,8,0" Click="CameraBtn_Click"/>
                                <ToggleButton x:Name="ScreenBtn" Content="🖥 Экран" Style="{StaticResource ToggleOutline}" Width="100" Margin="0,0,8,0" Click="ScreenBtn_Click"/>
                                <Button x:Name="ClearHistoryButton" Content="Очистить" Style="{StaticResource DarkButtonStyle}" Click="ClearHistoryButton_Click" Width="100"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- СПИСОК СООБЩЕНИЙ ЧАТА -->
                    <Border Grid.Row="1" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDim}" BorderThickness="1,1,1,0" CornerRadius="16,16,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#1E2330" BlurRadius="18" ShadowDepth="4" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <ListBox x:Name="ChatListBox" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     HorizontalContentAlignment="Stretch"
                                     VirtualizingPanel.ScrollUnit="Pixel" 
                                     SelectionChanged="ChatListBox_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="Transparent">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="18,6,18,6">
                                            <!-- CONTAINER ДЛЯ СООБЩЕНИЯ И ВСПЛЫВАШКИ -->
                                            <Grid x:Name="BubbleBox" HorizontalAlignment="Left" MaxWidth="850">
                                                <!-- MESSAGE BUBBLE -->
                                                <Border x:Name="MessageBorder" Padding="16,12"
                                                        CornerRadius="18,18,18,4"
                                                        Background="#FFFFFF" BorderBrush="{StaticResource BorderDim}" BorderThickness="1">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#1E2330" BlurRadius="10" ShadowDepth="2" Opacity="0.04"/>
                                                    </Border.Effect>
                                                    <StackPanel>
                                                        <TextBlock x:Name="SenderLabel" Text="{Binding Sender}" FontFamily="{StaticResource UI}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGlow}" Margin="0,0,0,5"/>
                                                        <TextBlock x:Name="MessageText" Text="{Binding DisplayText}" FontFamily="{StaticResource UI}" FontSize="14" Foreground="{StaticResource TextHigh}" TextWrapping="Wrap" LineHeight="22"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- FLOATING ACTION TOOLBAR (ВСПЛЫВАШКА) -->
                                                <Border x:Name="ActionButtons"
                                                        Visibility="Collapsed"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0,-12,8,0"
                                                        Background="#FFFFFF"
                                                        BorderBrush="{StaticResource BorderDim}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="3,2"
                                                        Panel.ZIndex="10">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#1E2330" BlurRadius="12" ShadowDepth="3" Opacity="0.14"/>
                                                    </Border.Effect>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="&#xE8C8;" ToolTip="Копировать" Style="{StaticResource FloatingActionIconBtn}" Click="CopyChatMessage_Click"/>
                                                        <Button Content="&#xE70F;" ToolTip="Правка" Style="{StaticResource FloatingActionIconBtn}" Click="EditChatMessage_Click"/>
                                                        <Button Content="&#xE74D;" ToolTip="Удалить" Style="{StaticResource FloatingActionIconBtn}" Click="DeleteChatMessage_Click"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <!-- USER MESSAGE STYLING -->
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter TargetName="BubbleBox" Property="HorizontalAlignment" Value="Right"/>
                                                <Setter TargetName="MessageBorder" Property="Background" Value="{StaticResource BgUserBubble}"/>
                                                <Setter TargetName="MessageBorder" Property="BorderThickness" Value="0"/>
                                                <Setter TargetName="MessageBorder" Property="CornerRadius" Value="18,18,4,18"/>
                                                <Setter TargetName="SenderLabel" Property="Foreground" Value="#E2EFFB"/>
                                                <Setter TargetName="MessageText" Property="Foreground" Value="#FFFFFF"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ActionButtons" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- ПРЕВЬЮ ВИДЕО/ЭКРАНА -->
                            <Border x:Name="VideoPreviewContainer" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12" Background="#1E2330" CornerRadius="12" Padding="6" Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="6" Opacity="0.3"/>
                                </Border.Effect>
                                <Grid>
                                    <Image x:Name="VideoPreviewImage" Height="160" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"/>
                                    <Button Content="✕" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Background="#99000000" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold" Click="CloseVideoPreview_Click" ToolTip="Скрыть превью">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="13"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ПОЛЕ ВВОДА (ВНИЗУ ЧАТА) -->
                    <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDim}" BorderThickness="1,1,1,1" CornerRadius="0,0,16,16">
                        <Border.Effect>
                            <DropShadowEffect Color="#1E2330" BlurRadius="18" ShadowDepth="4" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid Height="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AttachFileButton" Grid.Column="0" Content="&#xE723;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{StaticResource TextMid}" Height="42" Width="42" Click="AttachFileButton_Click" ToolTip="Прикрепить файл" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="Transparent" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#F2F8FD"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentBright}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#E2EFFB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBox x:Name="MessageTextBox" Grid.Column="1" Height="56" FontSize="14" Padding="12,0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" KeyDown="MessageTextBox_KeyDown" Foreground="{StaticResource TextHigh}"/>
                            <Button x:Name="SendMessageButton" Grid.Column="2" Content="ОТПРАВИТЬ" Height="44" Margin="0,0,8,0" FontSize="12" FontWeight="Bold" Click="SendMessageButton_Click"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <ItemsControl x:Name="ThumbnailContainer">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 3. НАСТРОЙКИ (MODAL OVERLAY) -->
            <Grid x:Name="SettingsOverlay" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="100">
                <Border Background="#591E2330" MouseDown="CloseSettings_Click"/>
                <Border Width="500" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="#FFFFFF" BorderBrush="{StaticResource BorderDim}" BorderThickness="1"
                        CornerRadius="18" Padding="28,24,28,26">
                    <Border.Effect>
                        <DropShadowEffect Color="#1E2330" BlurRadius="40" ShadowDepth="10" Opacity="0.18"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- HEADER -->
                        <Grid Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="18"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Настройки" FontFamily="{StaticResource BrandFont}"
                                           FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextHigh}"/>
                            </StackPanel>
                            <Button Content="&#xE8BB;" Click="CloseSettings_Click" Style="{StaticResource ChromeBtn}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Width="32" Height="32"/>
                        </Grid>

                        <!-- CARD 1: ГОЛОС -->
                        <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDim}"
                                BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Голос ассистента" FontFamily="{StaticResource UI}" FontSize="12"
                                           FontWeight="Bold" Foreground="{StaticResource TextMid}" Margin="0,0,0,8"/>
                                <ComboBox x:Name="VoiceTypeComboBox" Height="38">
                                    <ComboBoxItem Content="Aoede"/>
                                    <ComboBoxItem Content="Puck"/>
                                    <ComboBoxItem Content="Kore"/>
                                    <ComboBoxItem Content="Charon"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- CARD 2: МУЗЫКА -->
                        <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDim}"
                                BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Папка с музыкой" FontFamily="{StaticResource UI}" FontSize="12"
                                           FontWeight="Bold" Foreground="{StaticResource TextMid}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="MusicFolderPathTextBox" IsReadOnly="True" Height="38" Padding="12,0"/>
                                    <Button Grid.Column="1" Content="Выбрать"
                                            Style="{StaticResource DarkButtonStyle}"
                                            Margin="10,0,0,0" Width="100" Height="38"
                                            Click="ChooseMusicFolderButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Content="Готово" Click="CloseSettings_Click" HorizontalAlignment="Right" Width="110" Height="38"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
