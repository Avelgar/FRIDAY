<Window x:Class="Friday.Windows.AppPathsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка путей к приложениям" Height="450" Width="600"
        WindowStyle="None" Background="#302B3D" MouseDown="Window_MouseDown" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Стили копируем из главного окна для сохранения дизайна -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#625B71"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7B728A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#554E62"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#625B71"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="5" Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка окна -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Настройка путей к программам" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <Button Content="✖️" Width="30" Height="30" Click="Close_Click" Background="#4A4459" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" Panel.ZIndex="10"/>
        </Grid>

        <!-- Список программ -->
        <ScrollViewer Grid.Row="1" Margin="0,15,0,15" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AppsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#4A4459" CornerRadius="5" Padding="10" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Path}" Foreground="LightGray" TextWrapping="Wrap" Margin="10,0" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="Удалить" Background="#FF4A4A" Width="80" Height="25" Click="DeleteApp_Click" Tag="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Блок добавления -->
        <Border Grid.Row="2" Background="#4A4459" CornerRadius="5" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="AppNameTextBox" Grid.Column="0" Height="30" Text="Название (напр. Dota 2)" GotFocus="TextBox_GotFocus"/>
                <TextBox x:Name="AppPathTextBox" Grid.Column="1" Height="30" Margin="10,0" Text="Путь к .exe файлу" GotFocus="TextBox_GotFocus"/>
                <Button Grid.Column="2" Content="..." Width="30" Height="30" Margin="0,0,10,0" Click="BrowseApp_Click" ToolTip="Выбрать файл"/>
                <Button Grid.Column="3" Content="Добавить" Width="90" Height="30" Click="AddApp_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>