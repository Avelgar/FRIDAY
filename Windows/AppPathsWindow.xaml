<Window x:Class="Friday.Windows.AppPathsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка путей" Height="500" Width="650"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" MouseDown="Window_MouseDown">

    <Window.Resources>
        <FontFamily x:Key="BrandFont">pack://FRIDAY//Assets//IntroFriday.ttf</FontFamily>

        <!-- Стили (Изумрудная палитра) -->
        <SolidColorBrush x:Key="BgPanel" Color="#0E2018"/>
        <SolidColorBrush x:Key="BgInput" Color="#0A1A11"/>
        <SolidColorBrush x:Key="TextHigh" Color="#C8F0DC"/>
        <SolidColorBrush x:Key="TextMid" Color="#5BA07A"/>
        <SolidColorBrush x:Key="TextLow" Color="#2D5A40"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource TextHigh}"/>
            <Setter Property="BorderBrush" Value="#1A3D28"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Gill Sans MT"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#16A34A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#0E2018"/>
            <Setter Property="Foreground" Value="{StaticResource TextHigh}"/>
            <Setter Property="BorderBrush" Value="#1A3D28"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Gill Sans MT"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#142E1E"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#16A34A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F1515"/>
                    <Setter Property="BorderBrush" Value="#EF4444"/>
                    <Setter Property="Foreground" Value="#FECACA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#091510" BorderBrush="#1A3D28" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.7"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Grid Grid.Row="0" Margin="20,0,14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FRIDAY" FontFamily="{StaticResource BrandFont}" FontSize="18" Foreground="{StaticResource TextMid}"/>
                    <TextBlock Text="  ·  НАСТРОЙКА ПУТЕЙ" FontFamily="Gill Sans MT" FontSize="11" Foreground="{StaticResource TextLow}" VerticalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="✕" Click="Close_Click" Width="30" Height="30" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextLow}" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Контент -->
            <Border Grid.Row="1" Background="{StaticResource BgPanel}" CornerRadius="0,0,16,16" BorderBrush="#1A3D28" BorderThickness="0,1,0,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" Margin="0,0,0,15" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AppsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0A1A11" BorderBrush="#1A3D28" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource TextHigh}" FontFamily="Gill Sans MT" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Path}" Foreground="{StaticResource TextMid}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="10,0" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Content="УДАЛИТЬ" Style="{StaticResource DangerBtn}" Width="80" Height="30" Click="DeleteApp_Click" Tag="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="1" Background="#0A1A11" BorderBrush="#1A3D28" BorderThickness="1" CornerRadius="6" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AppNameTextBox" Grid.Column="0" Height="36" Text="Название (напр. Dota 2)" GotFocus="TextBox_GotFocus"/>
                            <TextBox x:Name="AppPathTextBox" Grid.Column="1" Height="36" Margin="10,0" Text="Путь к .exe файлу" GotFocus="TextBox_GotFocus"/>
                            <Button Grid.Column="2" Content="···" Background="#16A34A" BorderBrush="#16A34A" Width="36" Height="36" Margin="0,0,10,0" Click="BrowseApp_Click" ToolTip="Выбрать файл"/>
                            <Button Grid.Column="3" Content="ДОБАВИТЬ" Background="#16A34A" BorderBrush="#16A34A" Width="100" Height="36" Click="AddApp_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>