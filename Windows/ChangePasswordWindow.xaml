<Window x:Class="Friday.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Восстановление пароля" Height="370" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" MouseDown="Window_MouseDown">

    <Window.Resources>
        <FontFamily x:Key="BrandFont">Segoe UI, Montserrat, Inter</FontFamily>
        <FontFamily x:Key="UI">Segoe UI, Inter</FontFamily>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#F2F8FD"/>
            <Setter Property="Foreground" Value="#1E2330"/>
            <Setter Property="BorderBrush" Value="#DCE6F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource UI}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3A98D8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#FFFFFF" BorderBrush="#DCE6F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#1E2330" BlurRadius="35" ShadowDepth="8" Opacity="0.12"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOPBAR -->
            <Grid Grid.Row="0" Margin="18,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ПЯТНИЦА" FontFamily="{StaticResource BrandFont}" FontSize="15" FontWeight="Bold" Foreground="#3A98D8"/>
                    <TextBlock Text=" - Сброс пароля" FontFamily="{StaticResource UI}" FontSize="12" FontWeight="SemiBold" Foreground="#667085" VerticalAlignment="Center" Margin="0,1,0,0"/>
                </StackPanel>
                <Button Content="X" Click="Close_Click" Width="30" Height="30" Background="Transparent" BorderThickness="0" Foreground="#667085" HorizontalAlignment="Right" Cursor="Hand" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- BODY -->
            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="0,0,16,16" BorderBrush="#DCE6F0" BorderThickness="0,1,0,0" Padding="26,20,26,20">
                <StackPanel>
                    <TextBlock Text="Восстановление" FontFamily="{StaticResource BrandFont}" FontSize="22" FontWeight="Bold" Foreground="#1E2330" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <TextBlock Text="Логин или Email" FontFamily="{StaticResource UI}" FontSize="11" FontWeight="Bold" Foreground="#667085" Margin="2,0,0,6"/>
                    <TextBox x:Name="EmailTextBox" Margin="0,0,0,20"/>

                    <Button Content="Сбросить пароль" Click="ChangePasswordButton_Click" Foreground="#FFFFFF" BorderThickness="0" FontFamily="{StaticResource UI}" FontWeight="Bold" FontSize="13" Height="42" Cursor="Hand" Margin="0,0,0,16">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2478B4" Offset="0"/>
                                <GradientStop Color="#6850B7" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock HorizontalAlignment="Center">
                        <Hyperlink x:Name="OpenLoginWindowLink" Click="OpenLoginWindowLink_Click" Foreground="#2478B4" TextDecorations="None" FontFamily="{StaticResource UI}" FontSize="12" FontWeight="SemiBold">
                            Вернуться ко входу
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock x:Name="ErrorTextBlock" Foreground="#B83C54" FontFamily="{StaticResource UI}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
