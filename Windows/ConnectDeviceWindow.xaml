<Window x:Class="Friday.ConnectDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect Device"
        Height="566" Width="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        MouseDown="Window_MouseDown"
        ResizeMode="NoResize">

    <!-- Пульс орба запускается при загрузке окна -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <!-- Ring 1 -->
                    <DoubleAnimation Storyboard.TargetName="Ring1"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     From="0.2" To="1.3" Duration="0:0:2.8"/>
                    <DoubleAnimation Storyboard.TargetName="Ring1"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     From="0.2" To="1.3" Duration="0:0:2.8"/>
                    <DoubleAnimation Storyboard.TargetName="Ring1"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.55" To="0" Duration="0:0:2.8"/>
                    <!-- Ring 2 — сдвиг 0.9s -->
                    <DoubleAnimation Storyboard.TargetName="Ring2"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     From="0.2" To="1.3" Duration="0:0:2.8"
                                     BeginTime="0:0:0.9"/>
                    <DoubleAnimation Storyboard.TargetName="Ring2"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     From="0.2" To="1.3" Duration="0:0:2.8"
                                     BeginTime="0:0:0.9"/>
                    <DoubleAnimation Storyboard.TargetName="Ring2"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.35" To="0" Duration="0:0:2.8"
                                     BeginTime="0:0:0.9"/>
                    <!-- Ring 3 — сдвиг 1.8s -->
                    <DoubleAnimation Storyboard.TargetName="Ring3"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     From="0.2" To="1.3" Duration="0:0:2.8"
                                     BeginTime="0:0:1.8"/>
                    <DoubleAnimation Storyboard.TargetName="Ring3"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     From="0.2" To="1.3" Duration="0:0:2.8"
                                     BeginTime="0:0:1.8"/>
                    <DoubleAnimation Storyboard.TargetName="Ring3"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.2" To="0" Duration="0:0:2.8"
                                     BeginTime="0:0:1.8"/>
                    <!-- Центральный орб — мягкое дыхание -->
                    <DoubleAnimation Storyboard.TargetName="OrbCore"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.85" To="1.0" Duration="0:0:1.4"
                                     AutoReverse="True"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <FontFamily x:Key="BrandFont">pack://FRIDAY//Assets//IntroFriday.ttf</FontFamily>

        <!-- Изумрудная палитра -->
        <SolidColorBrush x:Key="Bg"           Color="#091510"/>
        <SolidColorBrush x:Key="BgPanel"      Color="#0E2018"/>
        <SolidColorBrush x:Key="BgInput"      Color="#0A1A11"/>
        <SolidColorBrush x:Key="BorderDim"    Color="#1A3D28"/>
        <SolidColorBrush x:Key="BorderFocus"  Color="#16A34A"/>
        <SolidColorBrush x:Key="Vibrant"      Color="#16A34A"/>
        <SolidColorBrush x:Key="Bright"       Color="#22C55E"/>
        <SolidColorBrush x:Key="Glow"         Color="#4ADE80"/>
        <SolidColorBrush x:Key="TextHigh"     Color="#C8F0DC"/>
        <SolidColorBrush x:Key="TextMid"      Color="#5BA07A"/>
        <SolidColorBrush x:Key="TextLow"      Color="#2D5A40"/>
        <SolidColorBrush x:Key="OrbRing"      Color="#22C55E"/>

        <LinearGradientBrush x:Key="BgGradient" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#0E2018" Offset="0"/>
            <GradientStop Color="#091510" Offset="0.5"/>
            <GradientStop Color="#060F0A" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="OrbGlow" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#4ADE80" Offset="0"/>
            <GradientStop Color="#16A34A" Offset="0.5"/>
            <GradientStop Color="#064722" Offset="1"/>
        </RadialGradientBrush>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background"               Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"               Value="{StaticResource TextHigh}"/>
            <Setter Property="CaretBrush"               Value="{StaticResource Bright}"/>
            <Setter Property="SelectionBrush"           Value="#1A3D28"/>
            <Setter Property="BorderBrush"              Value="{StaticResource BorderDim}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="FontFamily"               Value="Gill Sans MT"/>
            <Setter Property="FontSize"                 Value="14"/>
            <Setter Property="Height"                   Value="46"/>
            <Setter Property="Padding"                  Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#2D6A4F"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{StaticResource BorderFocus}"/>
                                <Setter TargetName="Root" Property="Background" Value="#0D1E14"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка — скругленная -->
        <Style x:Key="ConnectBtn" TargetType="Button">
            <Setter Property="Background"       Value="{StaticResource Vibrant}"/>
            <Setter Property="Foreground"       Value="#D1FAE5"/>
            <Setter Property="BorderBrush"      Value="{x:Null}"/>
            <Setter Property="FontFamily"       Value="Gill Sans MT"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FontWeight"       Value="Bold"/>
            <Setter Property="Height"           Value="52"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#14532D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка закрытия -->
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Width"            Value="30"/>
            <Setter Property="Height"           Value="30"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{StaticResource TextLow}"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1A3D28"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Внешняя оболочка -->
    <Border CornerRadius="16"
            Background="{StaticResource BgGradient}"
            BorderBrush="#1A3D28"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40"
                              ShadowDepth="10" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="180"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══ TITLE BAR ══ -->
            <Grid Grid.Row="0" Margin="20,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FRIDAY"
                               FontFamily="{StaticResource BrandFont}"
                               FontSize="18"
                               Foreground="{StaticResource TextMid}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  DEVICE PAIRING"
                               FontFamily="Gill Sans MT"
                               FontSize="11"
                               Foreground="{StaticResource TextLow}"
                               VerticalAlignment="Center"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="✕"
                        Style="{StaticResource CloseBtn}"
                        Click="CloseButton_Click"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- ══ ОРБ ══ -->
            <Grid Grid.Row="1">
                <!-- Фоновый glow за орбом -->
                <Ellipse Width="200" Height="200"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Opacity="0.06">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#22C55E" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Пульсирующие кольца -->
                <Ellipse x:Name="Ring1"
                         Width="110" Height="110"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Stroke="#22C55E" StrokeThickness="1"
                         Fill="Transparent"
                         Opacity="0"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse x:Name="Ring2"
                         Width="110" Height="110"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Stroke="#22C55E" StrokeThickness="1"
                         Fill="Transparent"
                         Opacity="0"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse x:Name="Ring3"
                         Width="110" Height="110"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Stroke="#22C55E" StrokeThickness="1"
                         Fill="Transparent"
                         Opacity="0"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Статичное внешнее кольцо -->
                <Ellipse Width="64" Height="64"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Stroke="#1A4A30" StrokeThickness="1"
                         Fill="Transparent"/>

                <!-- Орб ядро -->
                <Ellipse x:Name="OrbCore"
                         Width="44" Height="44"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#86EFAC" Offset="0"/>
                            <GradientStop Color="#16A34A" Offset="0.6"/>
                            <GradientStop Color="#064722" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#22C55E" BlurRadius="22"
                                          ShadowDepth="0" Opacity="0.9"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Grid>

            <!-- ══ ФОРМА ══ -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgPanel}"
                    CornerRadius="0,0,16,16">
                <!-- Тонкая линия сверху -->
                <Border BorderBrush="#1A3D28" BorderThickness="0,1,0,0">
                    <StackPanel>

                        <!-- Заголовок формы -->
                        <StackPanel Margin="28,24,28,20">
                            <TextBlock Text="Новое устройство"
                                       FontFamily="{StaticResource BrandFont}"
                                       FontSize="26"
                                       Foreground="{StaticResource TextHigh}"/>
                            <TextBlock Text="Введите данные для подключения к аккаунту"
                                       FontFamily="Gill Sans MT"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMid}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Поля -->
                        <StackPanel Margin="28,0,28,0">
                            <TextBlock Text="Имя устройства"
                                       FontFamily="Gill Sans MT"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextMid}"
                                       Margin="2,0,0,6"/>
                            <TextBox x:Name="DeviceNameTextBox" Margin="0,0,0,16"/>

                            <TextBlock Text="Пароль"
                                       FontFamily="Gill Sans MT"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextMid}"
                                       Margin="2,0,0,6"/>
                            <TextBox x:Name="PasswordBox" Margin="0,0,0,24"/>
                        </StackPanel>

                        <!-- Кнопка по ширине полей -->
                        <Button Content="ПОДКЛЮЧИТЬ"
                                Style="{StaticResource ConnectBtn}"
                                Click="ConnectButton_Click"
                                Margin="28,0,28,24"/>

                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
