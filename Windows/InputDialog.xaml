<Window x:Class="Friday.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ввод данных" Height="400" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" MouseDown="Window_MouseDown">

    <Window.Resources>
        <FontFamily x:Key="BrandFont">pack://FRIDAY//Assets//IntroFriday.ttf</FontFamily>
        
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0A1A11"/>
            <Setter Property="Foreground" Value="#C8F0DC"/>
            <Setter Property="BorderBrush" Value="#1A3D28"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Gill Sans MT"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#16A34A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#0E2018"/>
            <Setter Property="Foreground" Value="#C8F0DC"/>
            <Setter Property="BorderBrush" Value="#1A3D28"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Gill Sans MT"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#142E1E"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#16A34A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5BA07A"/>
            <Setter Property="FontFamily" Value="Gill Sans MT"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <!-- СТИЛЬ КНОПКИ РАСКРЫТИЯ COMBOBOX -->
        <Style x:Key="CbToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="r" CornerRadius="4" BorderThickness="1" Background="#0A1A11" BorderBrush="#1A3D28">
                            <Grid>
                                <ContentPresenter VerticalAlignment="Center" Margin="12,0,28,0"/>
                                <!-- Рисуем стрелочку -->
                                <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#5BA07A" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="r" Property="BorderBrush" Value="#16A34A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="r" Property="BorderBrush" Value="#16A34A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ШАБЛОН САМОГО COMBOBOX -->
        <ControlTemplate x:Key="CbTemplate" TargetType="{x:Type ComboBox}">
            <Grid>
                <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" PopupAnimation="Fade">
                    <!-- Выпадающее меню -->
                    <Border Background="#0E2018" BorderBrush="#16A34A" BorderThickness="1" Margin="0,2,0,0" CornerRadius="4">
                        <ScrollViewer Margin="2" MaxHeight="200">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </Popup>
                <ToggleButton Style="{StaticResource CbToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Margin="12,0,28,0" TextElement.Foreground="#C8F0DC"/>
            </Grid>
        </ControlTemplate>

        <!-- СТИЛЬ ЭЛЕМЕНТОВ (ITEM) ВНУТРИ ВЫПАДАЮЩЕГО СПИСКА -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#C8F0DC"/>
            <Setter Property="FontFamily" Value="Gill Sans MT"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A3D28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ПРИМЕНЕНИЕ ШАБЛОНА К COMBOBOX -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#C8F0DC"/>
            <Setter Property="FontFamily" Value="Gill Sans MT"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template" Value="{StaticResource CbTemplate}"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#091510" BorderBrush="#1A3D28" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.7"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="20,0,14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FRIDAY" FontFamily="{StaticResource BrandFont}" FontSize="18" Margin="0"/>
                    <TextBlock Text="  ·  СЦЕНАРИЙ" FontFamily="Gill Sans MT" FontSize="11" Foreground="#2D5A40" VerticalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="✕" Click="Close_Click" Width="30" Height="30" Background="Transparent" BorderThickness="0" Foreground="#2D5A40" HorizontalAlignment="Right"/>
            </Grid>

            <Border Grid.Row="1" Background="#0E2018" CornerRadius="0,0,16,16" BorderBrush="#1A3D28" BorderThickness="0,1,0,0" Padding="25">
                <StackPanel>
                    <TextBlock Text="Выберите действие"/>
                    <ComboBox x:Name="ActionTypeComboBox" SelectionChanged="ActionTypeComboBox_SelectionChanged" Margin="0,0,0,15" Height="38">
                        <ComboBoxItem Content="Открытие файла"/>
                        <ComboBoxItem Content="Открыть папку"/>
                        <ComboBoxItem Content="Завершение процесса"/>
                        <ComboBoxItem Content="Открытие ссылки"/>
                        <ComboBoxItem Content="Напечатать текст"/>
                        <ComboBoxItem Content="Отправить уведомление"/>
                        <ComboBoxItem Content="Нажать кнопку мыши"/>
                        <ComboBoxItem Content="Переместить мышь"/>
                        <ComboBoxItem Content="Голосовой ответ"/>
                        <ComboBoxItem Content="Текстовой ответ"/>
                        <ComboBoxItem Content="Изменение громкости"/>
                        <ComboBoxItem Content="Изменение яркости"/>
                        <ComboBoxItem Content="Музыка"/>
                        <ComboBoxItem Content="Погода"/>
                        <ComboBoxItem Content="Смена имени"/>
                        <ComboBoxItem Content="Смена голоса"/>
                        <ComboBoxItem Content="Очистка истории"/>
                        <ComboBoxItem Content="Режим камеры"/>
                        <ComboBoxItem Content="Выключить режим камеры"/>
                        <ComboBoxItem Content="Скриншот"/>
                        <ComboBoxItem Content="Ожидание"/>
                    </ComboBox>
                    
                    <ComboBox x:Name="ProcessComboBox" Margin="0,0,0,15" Height="38" Visibility="Collapsed" />

                    <TextBlock Text="Введите параметры" x:Name="ParamsLabel"/>
                    <Button x:Name="FileButton" Content="ВЫБРАТЬ ФАЙЛ" Click="FileButton_Click" Height="36" Margin="0,0,0,10" Visibility="Collapsed"/>
                    <Button x:Name="SelectFolderButton" Content="УКАЗАТЬ ПУТЬ" Click="SelectFolderButton_Click" Height="36" Margin="0,0,0,10" Visibility="Collapsed"/>
                    
                    <TextBox x:Name="InputTextBox" Height="100" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20"/>
                    
                    <Button Content="СОХРАНИТЬ ДЕЙСТВИЕ" Click="OkButton_Click" Background="#16A34A" BorderBrush="#16A34A" Foreground="#D1FAE5" Height="42"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>