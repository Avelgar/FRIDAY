<Window x:Class="Friday.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация устройства" Height="360" Width="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" MouseDown="Window_MouseDown">

    <Window.Resources>
        <FontFamily x:Key="BrandFont">pack://FRIDAY//Assets//IntroFriday.ttf</FontFamily>

        <!-- СТИЛЬ ДЛЯ TEXTBOX -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0A1A11"/>
            <Setter Property="Foreground" Value="#C8F0DC"/>
            <Setter Property="BorderBrush" Value="#1A3D28"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Gill Sans MT"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#16A34A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- НЕЗАВИСИМЫЙ СТИЛЬ ДЛЯ PASSWORDBOX -->
        <Style x:Key="SciFiPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#0A1A11"/>
            <Setter Property="Foreground" Value="#C8F0DC"/>
            <Setter Property="BorderBrush" Value="#1A3D28"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Gill Sans MT"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Root" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#16A34A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#091510" BorderBrush="#1A3D28" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.7"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ШАПКА -->
            <Grid Grid.Row="0" Margin="20,0,14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FRIDAY" FontFamily="{StaticResource BrandFont}" FontSize="18" Foreground="#5BA07A"/>
                    <TextBlock Text="  ·  ИНИЦИАЛИЗАЦИЯ" FontFamily="Gill Sans MT" FontSize="11" Foreground="#2D5A40" VerticalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="✕" Click="Close_Click" Width="30" Height="30" Background="Transparent" BorderThickness="0" Foreground="#2D5A40" HorizontalAlignment="Right" Cursor="Hand"/>
            </Grid>

            <!-- ТЕЛО -->
            <Border Grid.Row="1" Background="#0E2018" CornerRadius="0,0,16,16" BorderBrush="#1A3D28" BorderThickness="0,1,0,0" Padding="25">
                <StackPanel>
                    <TextBlock Text="Новое устройство" FontFamily="{StaticResource BrandFont}" FontSize="24" Foreground="#C8F0DC" Margin="0,0,0,25" HorizontalAlignment="Center"/>

                    <TextBlock Text="Имя устройства" FontFamily="Gill Sans MT" FontSize="12" FontWeight="Bold" Foreground="#5BA07A" Margin="2,0,0,6"/>
                    <!-- Имя контрола оставлено DeviceNameTextBox как в вашем оригинале -->
                    <TextBox x:Name="DeviceNameTextBox" Margin="0,0,0,15" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Системный пароль" FontFamily="Gill Sans MT" FontSize="12" FontWeight="Bold" Foreground="#5BA07A" Margin="2,0,0,6"/>
                    <!-- В вашем оригинале это поле называлось PasswordTextBox, хоть это и PasswordBox. Я сохранил оригинальное имя (x:Name), чтобы код не сломался. -->
                    <PasswordBox x:Name="PasswordTextBox" Style="{StaticResource SciFiPasswordBox}" Margin="0,0,0,25"/>

                    <Button Content="ПРИНЯТЬ КОНФИГУРАЦИЮ" Click="RegisterButton_Click" Background="#16A34A" Foreground="#D1FAE5" BorderThickness="0" FontFamily="Gill Sans MT" FontWeight="Bold" FontSize="13" Height="42" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>